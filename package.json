		"date-fns": "^4.4.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fullcalendar": "^7.1.4",
		"globals": "^17.6.0",
		"html-to-text": "^10.0.1",
